# Copy to .env.local and fill in. Never commit .env.local.

# "mock" runs everything in-process with no PayPal account (for UI work).
# "sandbox" uses the real PayPal sandbox. The demo and video use sandbox.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# Only used if go/no-go test 1 passes. Leave at 0 for the single-merchant version.
PAYPAL_MULTI_MERCHANT=0
MERCHANT_A_EMAIL=
MERCHANT_B_EMAIL=
MERCHANT_C_EMAIL=

# "mock" uses a rule-based stand-in (UI work only, clearly labelled in the UI).
# "live" calls Gemini with the real spec sheets. The demo and the accuracy run use live.
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL_PRO=
GEMINI_MODEL_FLASH=
# Optional: LOW or MINIMAL if audit calls are too slow. Leave blank for the model default.
GEMINI_THINKING_LEVEL=
# Hard cap on Gemini calls per server process per day (cost guard on the public demo).
MAX_AI_CALLS_PER_DAY=300
